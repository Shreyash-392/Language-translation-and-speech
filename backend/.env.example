# Hugging Face Access Token (Optional for cached/offline execution, required for initial gated download if applicable)
HF_TOKEN=

# Offline Mode Configuration
OFFLINE_MODE=false

# Directory where AI models are stored/cached
MODEL_DIR=./model_cache
HF_HOME=./model_cache

# Model Identifiers
INDIC_ASR_MODEL=ai4bharat/indic-conformer-600m-multilingual
INDICTRANS_MODEL=ai4bharat/indictrans2-indic-indic-dist-320M
TTS_MODEL=ai4bharat/indic-parler-tts

# Execution Hardware Device (cuda or cpu)
DEVICE=cuda

# Application Settings
HOST=0.0.0.0
PORT=8000
